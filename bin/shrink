#!/usr/bin/env python3
"""shrink — read your own Claude Code history and hand back a read of you.

Single binary, stdlib only. Everything the plugin does goes through here so the
user needs exactly one permission rule: Bash(shrink:*).

Subcommands
    digest    extract + denoise + dry-tier stats
    sample    emit a stratified labeling set (M1 eval)
    excerpt   fetch context around a turn id          [M3]
    verify    check a quote byte-exact against source [M3]
    render    build the report                        [M5]
    purge     wipe reports and cache

Design contracts live in SCHEMA.md. The short version: the JSONL format is
internal and unstable, so this is an archaeologist — it skips bad lines, keeps
unknowns rather than dropping them, and stamps everything with the build that
wrote it.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import statistics
import sys
from collections import Counter, defaultdict
from pathlib import Path

SUMMARY_VERSION = 1  # bump to force re-derivation of cached output

PLUGIN_ROOT = Path(os.environ.get(
    "CLAUDE_PLUGIN_ROOT", Path(__file__).resolve().parent.parent))

CLAUDE_HOME = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
PROJECTS_DIR = CLAUDE_HOME / "projects"
HISTORY_FILE = CLAUDE_HOME / "history.jsonl"

# Directories that live *inside* a project dir but are not sessions.
EXCLUDED_SUBDIRS = {"subagents", "tool-results"}

# Blocks injected into authored turns. Stripped, never used to discard a turn:
# a reminder appended to something you typed does not make it not-yours.
#
# Enumerated by scanning every non-tool user record on the reference corpus for
# tags in opening position — the position that decides authorship. Probe #4.
# task-notification (159 records) and local-command-caveat (49) were both
# missing from the original observational list and were being scored as human
# speech; task-notification alone was 18% of the first eval sample.
INJECTED_TAGS = (
    "system-reminder",
    "task-notification",
    "command-name",
    "command-message",
    "command-args",
    "command-contents",
    "local-command-caveat",
    "local-command-stdout",
    "local-command-stderr",
)
_TAGS = "|".join(INJECTED_TAGS)

WRAPPER_RE = re.compile(rf"<({_TAGS})>.*?</\1>|<({_TAGS})\s*/>", re.DOTALL)
# Unclosed variants show up when output was truncated mid-write.
DANGLING_RE = re.compile(rf"<({_TAGS})>.*\Z", re.DOTALL)
# Opening-position match: a record that *starts* with an injected block was
# delivered by the harness, not typed.
LEADING_RE = re.compile(rf"\s*<({_TAGS})>")

# Bare harness markers: not tagged, not flagged, indistinguishable from typed
# text by structure alone. Found by hand-labeling, not by the tag scan.
INTERRUPT_RE = re.compile(r"^\s*\[Request interrupted by user[^\]]*\]\s*$")
IMAGE_MARKER_RE = re.compile(r"^\s*\[Image:\s*source:[^\]]*\]\s*$")


# --------------------------------------------------------------------------
# discovery
# --------------------------------------------------------------------------

def session_files(projects_dir: Path = PROJECTS_DIR) -> list[Path]:
    """Top-level <UUID>.jsonl per project dir only.

    Both known subagent layouts are excluded: the flat `agent-*.jsonl` of older
    builds and the nested `<session>/subagents/` of current ones. A recursive
    glob here would ingest subagent prose as if the human wrote it.
    """
    out: list[Path] = []
    if not projects_dir.is_dir():
        return out
    for proj in sorted(projects_dir.iterdir()):
        if not proj.is_dir():
            continue
        for f in sorted(proj.glob("*.jsonl")):
            if f.name.startswith("agent-"):
                continue
            out.append(f)
    return out


def project_label(path: Path) -> str:
    """Mangled cwd -> the original path, best effort."""
    return "/" + path.parent.name.lstrip("-").replace("-", "/")


# --------------------------------------------------------------------------
# normalization
# --------------------------------------------------------------------------

class Turn:
    __slots__ = (
        "turn_id", "session_id", "uuid", "parent_uuid", "ts", "project",
        "kind", "text", "typed", "pasted_chars", "raw_len", "segment",
        "line_no", "build", "looks_pasted", "role",
    )

    def __init__(self, **kw):
        for k in self.__slots__:
            setattr(self, k, kw.get(k))

    def as_dict(self) -> dict:
        return {k: getattr(self, k) for k in self.__slots__}


def strip_wrappers(text: str) -> str:
    text = WRAPPER_RE.sub("", text)
    text = DANGLING_RE.sub("", text)
    return text.strip()


def looks_pasted(text: str) -> bool:
    """Size + newline density. A flag, not a verdict — the eval set adjudicates."""
    if len(text) < 1500:
        return False
    lines = text.count("\n") + 1
    return lines >= 20 and (len(text) / lines) < 120


def extract_text(content) -> tuple[str | None, str]:
    """Return (text, reason). text is None when the record is not authored."""
    if isinstance(content, str):
        return content, "string"
    if isinstance(content, list):
        kinds = {b.get("type") for b in content if isinstance(b, dict)}
        if "tool_result" in kinds:
            return None, "tool_result"
        parts = [
            b.get("text", "")
            for b in content
            if isinstance(b, dict) and b.get("type") == "text"
        ]
        if not parts:
            return None, "no_text_block"
        return "\n".join(parts), "text_block"
    return None, "unrecognized_content"


def preview(rec: dict) -> str:
    """Something showable for a record with no authored text.

    A blank card is unlabelable — the human has to see what the record actually
    was in order to judge whether the classifier got it right.
    """
    content = rec.get("message", {}).get("content")
    if isinstance(content, list):
        out = []
        for b in content:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "tool_result":
                body = b.get("content")
                if isinstance(body, list):
                    body = " ".join(
                        x.get("text", "") for x in body if isinstance(x, dict))
                out.append(f"[tool_result] {str(body)[:700]}")
            else:
                out.append(f"[{b.get('type')}] {json.dumps(b)[:300]}")
        if out:
            return "\n".join(out)
    tur = rec.get("toolUseResult")
    if tur is not None:
        return f"[toolUseResult] {json.dumps(tur)[:700]}"
    return "[no content] " + json.dumps(
        {k: v for k, v in rec.items() if k not in ("message",)})[:500]


def classify(rec: dict) -> tuple[str, str]:
    """(kind, reason) for a type:"user" record.

    kind is one of: authored, tool_result, meta, sidechain, empty, unrecognized.
    Order matters — toolUseResult carries ~86% of the discrimination.
    """
    if rec.get("toolUseResult") is not None:
        return "tool_result", "toolUseResult"
    if rec.get("isSidechain"):
        return "sidechain", "isSidechain"
    if rec.get("userType") not in (None, "external"):
        return "sidechain", "userType"
    text, reason = extract_text(rec.get("message", {}).get("content"))
    if text is None:
        return ("tool_result", reason) if reason == "tool_result" else ("unrecognized", reason)
    if rec.get("isMeta"):
        return "meta", "isMeta"
    # An interrupt is not speech, but it *is* behaviour — the tool records it as
    # an event (see Corpus.interrupts) and drops it from the text corpus.
    if INTERRUPT_RE.match(text):
        return "meta", "interrupt_marker"
    if IMAGE_MARKER_RE.match(text):
        return "meta", "image_marker"
    if not strip_wrappers(text):
        # Wholly injected: a task notification, a slash-command echo, a caveat.
        # Machine-delivered, so meta — "empty" is reserved for records that were
        # genuinely blank to begin with.
        if LEADING_RE.match(text):
            return "meta", "injected_only"
        return "empty", "no_content"
    return "authored", reason


def read_session(path: Path) -> tuple[list[Turn], Counter, list[dict]]:
    """Parse one session file. Never throws on content."""
    turns: list[Turn] = []
    events: list[dict] = []
    stats: Counter = Counter()
    session_id = path.stem
    project = project_label(path)
    segment = 0

    with path.open(errors="replace") as fh:
        for line_no, line in enumerate(fh):
            if not line.strip():
                continue
            try:
                rec = json.loads(line)
            except (json.JSONDecodeError, ValueError):
                stats["unparseable_lines"] += 1
                continue
            if not isinstance(rec, dict):
                stats["non_object_lines"] += 1
                continue

            rtype = rec.get("type")
            stats[f"type:{rtype}"] += 1

            # Segment breaks: compaction and any orphan root. Ordering never
            # crosses one of these — see SCHEMA.md / amendment A14.
            if rtype == "system" and rec.get("subtype") == "compact_boundary":
                segment += 1
                stats["compact_boundaries"] += 1
                continue
            if rtype in ("user", "assistant") and line_no and rec.get("parentUuid") is None:
                segment += 1
                stats["orphan_roots"] += 1

            if rtype == "assistant":
                # Metadata only. Text is fetched on demand by `excerpt`.
                stats["assistant_turns"] += 1
                continue
            if rtype != "user":
                continue

            kind, reason = classify(rec)
            stats[f"user:{kind}"] += 1
            stats[f"reason:{reason}"] += 1
            if reason == "interrupt_marker":
                events.append({
                    "kind": "interrupt",
                    "session_id": session_id,
                    "ts": rec.get("timestamp"),
                    "project": project,
                    "segment": segment,
                })
            if kind != "authored":
                continue

            raw, _ = extract_text(rec.get("message", {}).get("content"))
            text = strip_wrappers(raw or "")
            uid = rec.get("uuid") or f"line{line_no}"
            typed, pasted = paste_split(text)
            turns.append(Turn(
                turn_id=f"{session_id}:{uid}",
                session_id=session_id,
                uuid=uid,
                parent_uuid=rec.get("parentUuid"),
                ts=rec.get("timestamp"),
                project=project,
                kind="authored",
                text=text,
                typed=typed,
                pasted_chars=len(pasted),
                raw_len=len(raw or ""),
                segment=segment,
                line_no=line_no,
                build=rec.get("version"),
                looks_pasted=looks_pasted(text),
                role="user",
            ))

    return turns, stats, events


def read_history(path: Path = HISTORY_FILE) -> list[dict]:
    """The long-baseline tier. Authored prompts only, survives the 30-day sweep."""
    out: list[dict] = []
    if not path.is_file():
        return out
    for line in path.open(errors="replace"):
        try:
            rec = json.loads(line)
        except (json.JSONDecodeError, ValueError):
            continue
        if not isinstance(rec, dict):
            continue
        text = rec.get("display")
        if not isinstance(text, str) or not text.strip():
            continue
        out.append({
            "text": strip_wrappers(text),
            "ts": rec.get("timestamp"),
            "project": rec.get("project"),
            "session_id": rec.get("sessionId"),
        })
    return out


# --------------------------------------------------------------------------
# corpus
# --------------------------------------------------------------------------

class Corpus:
    def __init__(self, turns, stats, files, history, events=None):
        self.turns = turns
        self.stats = stats
        self.files = files
        self.history = history
        self.events = events or []

    @classmethod
    def load(cls, days: int | None = None) -> "Corpus":
        files = session_files()
        turns: list[Turn] = []
        events: list[dict] = []
        stats: Counter = Counter()
        seen_uuids: dict[str, str] = {}
        for f in files:
            t, s, ev = read_session(f)
            stats.update(s)
            events.extend(ev)
            for turn in t:
                # Cheap insurance against resume-replay. Not observed on the
                # reference build, but free.
                prior = seen_uuids.get(turn.uuid)
                if prior and prior != turn.session_id:
                    stats["replayed_uuids"] += 1
                    continue
                seen_uuids[turn.uuid] = turn.session_id
                turns.append(turn)
        turns.sort(key=lambda t: (t.ts or "", t.session_id, t.line_no))
        history = read_history()

        if days:
            cutoff = _cutoff(days)
            if cutoff:
                turns = [t for t in turns if (t.ts or "") >= cutoff]
                events = [e for e in events if (e.get("ts") or "") >= cutoff]
        return cls(turns, stats, files, history, events)

    @property
    def authored_chars(self) -> int:
        return sum(len(t.text) for t in self.turns)


def _cutoff(days: int) -> str | None:
    """ISO cutoff string, derived from the newest record rather than wall clock
    so a stale corpus doesn't silently return nothing."""
    import datetime
    now = datetime.datetime.now(datetime.timezone.utc)
    return (now - datetime.timedelta(days=days)).isoformat().replace("+00:00", "Z")


# --------------------------------------------------------------------------
# paste extraction
# --------------------------------------------------------------------------

# A record can be genuinely authored and still be mostly someone else's bytes:
# a two-line preamble followed by a pasted report. Classification is a decision
# about the record; this is a decision about the bytes inside it.
#
# Deliberately conservative — it only splits on markers that a person is
# unlikely to type mid-message in a chat prompt. Under-trimming leaves noise
# that shows up as histogram outliers; over-trimming silently deletes speech,
# which is worse and invisible.
PASTE_MARKER = re.compile(
    r"^(?:"
    r"```|~~~"                 # fenced code
    r"|#{1,6}\s+\S"            # markdown heading
    r"|\s*\|.*\|\s*$"          # table row
    r"|(?:From|To|Subject|Sent|On .{0,40}wrote):\s"   # quoted mail
    r"|\s{4,}\S"               # indented block
    r"|<[a-zA-Z!/][^>]*>\s*$"  # lone markup line
    r")",
    re.M,
)
MIN_SPLIT_LEN = 800   # below this, a marker is more likely to be real writing


def paste_split(text: str) -> tuple[str, str]:
    """(typed, pasted). Best effort, and honest about being best effort."""
    if len(text) < MIN_SPLIT_LEN:
        return text, ""
    m = PASTE_MARKER.search(text)
    if not m:
        return text, ""
    head = text[:m.start()].rstrip()
    tail = text[m.start():]
    # A marker in the first few characters means the whole record is pasted.
    # A marker near the end means the "paste" is a signature or a snippet, and
    # trimming it buys nothing.
    if len(tail) < 200:
        return text, ""
    return head, tail


# --------------------------------------------------------------------------
# dry tier
# --------------------------------------------------------------------------

HEDGES = (
    "maybe", "perhaps", "might", "possibly", "probably", "sort of", "kind of",
    "i think", "i guess", "i suppose", "seems", "somewhat", "a bit", "a little",
    "not sure", "if that makes sense", "or something", "i wonder", "could be",
)
POLITENESS = (
    "please", "thanks", "thank you", "sorry", "appreciate", "if you could",
    "would you mind", "no rush", "when you get a chance", "great", "nice work",
    "well done", "perfect", "awesome", "love it",
)
PROFANITY = (
    "damn", "hell", "crap", "shit", "fuck", "fucking", "goddamn", "wtf",
    "bullshit", "ass", "dammit",
)
REPAIR = (
    "no, i said", "that's not", "thats not", "i said", "actually no", "wrong",
    "not what i", "you missed", "try again", "revert", "undo", "nope",
    "still broken", "still failing", "didn't work", "doesn't work",
)
IMPERATIVE_STARTS = (
    "add", "build", "change", "check", "clean", "commit", "create", "delete",
    "do", "don't", "dont", "draft", "drop", "explain", "find", "fix", "get",
    "give", "go", "implement", "install", "keep", "let's", "lets", "look",
    "make", "move", "open", "print", "pull", "push", "put", "read", "remove",
    "rename", "replace", "run", "search", "set", "show", "start", "stop",
    "switch", "take", "tell", "try", "update", "use", "write", "walk", "help",
)
FIRST_P_SING = ("i", "me", "my", "mine", "myself", "i'm", "im", "i've", "i'll", "i'd")
FIRST_P_PLUR = ("we", "us", "our", "ours", "ourselves", "we're", "we've", "we'll", "let's", "lets")
SECOND_P = ("you", "your", "yours", "yourself", "you're", "youre", "you've", "you'll")

WORD = re.compile(r"[a-z']+")
SENTENCE = re.compile(r"[^.!?\n]+[.!?]?")


def tokens(text: str) -> list[str]:
    return WORD.findall(text.lower())


def phrase_rate(text: str, phrases, per: int = 1000) -> float:
    """Hits per `per` words. Multi-word phrases counted as substrings."""
    low = " " + " ".join(tokens(text)) + " "
    n = len(tokens(text))
    if not n:
        return 0.0
    hits = sum(low.count(" " + p + " ") if " " not in p else low.count(p)
               for p in phrases)
    return per * hits / n


# Words people actually shout. A closed list, because the alternatives failed:
# a naive \b[A-Z]{3,}\b count scored 11.35 per 1k words on the reference corpus
# and was almost entirely domain jargon (OPL, QKD, LDPC, BLE). Gating on "the
# word also appears lowercase somewhere" failed too — PQC, AWS and FPGA all
# appear lowercase inside paths and commands, so acronyms passed anyway.
#
# Reading either number as "shouting" would be exactly the horoscope failure
# this project exists to avoid: a real measurement of the wrong thing.
EMPHATIC = frozenset("""
    NOT NEVER ALWAYS ALL NONE ONLY EVERY MUST STOP DO DONT DON'T PLEASE
    NO YES REALLY VERY NOW THIS THAT AND BUT ANY EVER JUST STILL WHY
    WRONG BROKEN WORKS WORKING FAILED READ USE
""".split())


def caps_words(text: str) -> int:
    """Emphatic capitals only — ordinary words shouted, not vocabulary."""
    return sum(1 for w in re.findall(r"\b[A-Z']{2,}\b", text) if w in EMPHATIC)


def mood(text: str) -> str:
    """question / imperative / statement, on the first sentence."""
    s = text.strip()
    if not s:
        return "statement"
    first = (SENTENCE.match(s).group(0) if SENTENCE.match(s) else s).strip()
    if first.endswith("?"):
        return "question"
    w = tokens(first)
    if w and w[0] in IMPERATIVE_STARTS:
        return "imperative"
    return "statement"


def local_hour(ts: str | None):
    if not ts:
        return None
    import datetime
    try:
        dt = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None
    return dt.astimezone()


def slope(points: list[tuple[float, float]]) -> float | None:
    """Least-squares slope. None when there isn't enough spread to mean anything."""
    if len(points) < 3:
        return None
    xs = [p[0] for p in points]
    ys = [p[1] for p in points]
    mx, my = statistics.mean(xs), statistics.mean(ys)
    denom = sum((x - mx) ** 2 for x in xs)
    if denom == 0:
        return None
    return sum((x - mx) * (y - my) for x, y in points) / denom


def measure(texts: list[str]) -> dict:
    """The measures that apply to any bag of authored text."""
    joined = "\n".join(texts)
    toks = tokens(joined)
    n = len(toks) or 1
    lens = [len(t) for t in texts] or [0]
    moods = Counter(mood(t) for t in texts)
    counts = Counter(toks)
    return {
        "turns": len(texts),
        "words": len(toks),
        "median_chars": int(statistics.median(lens)),
        "mean_chars": int(statistics.mean(lens)),
        "p95_chars": sorted(lens)[int(0.95 * (len(lens) - 1))],
        "hedging_per_1k": round(phrase_rate(joined, HEDGES), 2),
        "politeness_per_1k": round(phrase_rate(joined, POLITENESS), 2),
        "profanity_per_1k": round(phrase_rate(joined, PROFANITY), 2),
        "repair_per_1k": round(phrase_rate(joined, REPAIR), 2),
        "caps_per_1k": round(1000 * caps_words(joined) / n, 2),
        "question_ratio": round(moods["question"] / max(1, len(texts)), 3),
        "imperative_ratio": round(moods["imperative"] / max(1, len(texts)), 3),
        "we_vs_i": round(
            sum(counts[w] for w in FIRST_P_PLUR) /
            max(1, sum(counts[w] for w in FIRST_P_SING)), 3),
        "you_per_1k": round(1000 * sum(counts[w] for w in SECOND_P) / n, 2),
    }


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def cmd_digest(args) -> int:
    corpus = Corpus.load(days=args.days)
    if not corpus.files:
        print(f"No sessions found under {PROJECTS_DIR}.", file=sys.stderr)
        return 2

    s = corpus.stats
    user_total = sum(v for k, v in s.items() if k.startswith("user:"))
    authored = s.get("user:authored", 0)

    print(f"shrink digest  (SUMMARY_VERSION {SUMMARY_VERSION})")
    print(f"  sessions       {len(corpus.files)}")
    print(f"  window         {args.days} days" if args.days else "  window         all")
    print()
    print("  denoiser")
    print(f"    user records      {user_total:>8,}")
    for kind in ("authored", "tool_result", "meta", "sidechain", "empty", "unrecognized"):
        n = s.get(f"user:{kind}", 0)
        if n:
            pct = 100 * n / user_total if user_total else 0
            print(f"      {kind:<16} {n:>8,}  {pct:5.1f}%")
    print(f"    assistant turns   {s.get('assistant_turns', 0):>8,}  (metadata only)")
    print()
    print("  corpus")
    print(f"    authored turns    {len(corpus.turns):>8,}")
    print(f"    authored chars    {corpus.authored_chars:>8,}")
    if corpus.turns:
        lens = [len(t.text) for t in corpus.turns]
        print(f"    median turn       {int(statistics.median(lens)):>8,} chars")
        print(f"    span              {corpus.turns[0].ts} -> {corpus.turns[-1].ts}")
        pasted = sum(1 for t in corpus.turns if t.looks_pasted)
        print(f"    flagged as paste  {pasted:>8,}")
    interrupts = sum(1 for e in corpus.events if e["kind"] == "interrupt")
    if interrupts:
        per = interrupts / max(1, len(corpus.files))
        print(f"    interrupts        {interrupts:>8,}  ({per:.2f}/session)")
    print()
    print("  long baseline (history.jsonl)")
    if corpus.history:
        hs = [h["ts"] for h in corpus.history if h.get("ts")]
        print(f"    prompts           {len(corpus.history):>8,}")
        print(f"    projects          {len({h.get('project') for h in corpus.history}):>8,}")
        if hs:
            import datetime
            fmt = lambda t: datetime.datetime.fromtimestamp(
                t / 1000 if t > 1e11 else t).date()
            print(f"    span              {fmt(min(hs))} -> {fmt(max(hs))}")
    else:
        print("    (none found)")

    builds = Counter(t.build for t in corpus.turns if t.build)
    if builds:
        print()
        print("  builds observed   " + ", ".join(
            f"{b} ({n})" for b, n in builds.most_common(6)))

    unknown = {k[5:]: v for k, v in s.items()
               if k.startswith("type:") and k[5:] not in KNOWN_TYPES}
    if unknown:
        print()
        print("  UNKNOWN record types (archived, not dropped):")
        for t, n in sorted(unknown.items(), key=lambda kv: -kv[1]):
            print(f"    {t:<28} {n:>8,}")

    for key, label in (("unparseable_lines", "unparseable lines"),
                       ("replayed_uuids", "replayed uuids dropped"),
                       ("compact_boundaries", "compact boundaries"),
                       ("orphan_roots", "orphan segment roots")):
        if s.get(key):
            print(f"  {label}: {s[key]:,}")

    if args.json:
        Path(args.json).write_text(json.dumps(
            {"summary_version": SUMMARY_VERSION,
             "stats": dict(s),
             "turns": [t.as_dict() for t in corpus.turns]},
            indent=2))
        print(f"\n  wrote {args.json}")
    return 0


KNOWN_TYPES = {
    "user", "assistant", "system", "attachment", "last-prompt", "mode",
    "permission-mode", "queue-operation", "ai-title", "bridge-session",
    "file-history-snapshot", "file-history-delta", "pr-link", "summary",
    "progress", "custom-title", "agent-name",
}


def cmd_sample(args) -> int:
    """Stratified labeling set for the M1 precision eval.

    Deliberately samples across the *decision boundary*, not the easy middle:
    every kind, plus the wrapper-heavy and paste-flagged cases where the rule is
    most likely to be wrong.
    """
    files = session_files()
    seen: set[str] = set()
    for prev in (args.exclude or []):
        pp = Path(prev)
        if pp.is_file():
            seen |= {json.loads(l)["turn_id"] for l in pp.open() if l.strip()}
    buckets: dict[str, list[dict]] = defaultdict(list)
    for f in files:
        session_id = f.stem
        for line_no, line in enumerate(f.open(errors="replace")):
            if not line.strip():
                continue
            try:
                rec = json.loads(line)
            except (json.JSONDecodeError, ValueError):
                continue
            if not isinstance(rec, dict) or rec.get("type") != "user":
                continue
            kind, reason = classify(rec)
            raw, _ = extract_text(rec.get("message", {}).get("content"))
            raw = raw or ""
            stripped = strip_wrappers(raw)
            bucket = kind
            if kind == "authored" and raw != stripped:
                bucket = "authored_wrapped"
            if kind == "authored" and looks_pasted(stripped):
                bucket = "authored_paste_flagged"
            turn_id = f"{session_id}:{rec.get('uuid') or line_no}"
            if turn_id in seen:
                continue
            shown = stripped or raw or preview(rec)
            buckets[bucket].append({
                "turn_id": turn_id,
                "predicted": kind,
                "reason": reason,
                "label": None,
                "excerpt": shown[:900],
                "raw_len": len(raw),
            })

    # Precision is TP/(TP+FP) over *predicted-authored* rows, so half the budget
    # goes there. An even split across buckets spends most of the labeling
    # effort confirming obvious tool results and leaves the number that actually
    # gates M1 resting on a few dozen rows.
    authored_buckets = {b for b in buckets if b.startswith("authored")}
    other = set(buckets) - authored_buckets
    budget = {}
    if authored_buckets:
        share = (args.n // 2) // len(authored_buckets)
        budget.update({b: max(1, share) for b in authored_buckets})
    if other:
        share = (args.n - sum(budget.values())) // len(other)
        budget.update({b: max(1, share) for b in other})

    out: list[dict] = []
    for bucket, items in sorted(buckets.items()):
        per = budget.get(bucket, 1)
        step = max(1, len(items) // per)
        picked = items[::step][:per]
        for row in picked:
            row["bucket"] = bucket
        out.extend(picked)

    dest = Path(args.out)
    dest.parent.mkdir(parents=True, exist_ok=True)
    with dest.open("w") as fh:
        for row in out:
            fh.write(json.dumps(row) + "\n")

    print(f"wrote {len(out)} rows to {dest}")
    for bucket, items in sorted(buckets.items()):
        n = sum(1 for r in out if r["bucket"] == bucket)
        print(f"  {bucket:<24} sampled {n:>4}  of {len(items):>7,}")
    print("\nSet \"label\" on each row to the true kind, then: shrink eval")
    return 0


def find_records(turn_ids: set[str]) -> dict[str, dict]:
    """turn_id -> raw record, by scanning the sessions named in the ids.

    Also the lookup `excerpt` and `verify` are built on: quotes travel by id and
    are re-read from source, never re-typed by any layer.
    """
    wanted: dict[str, set[str]] = defaultdict(set)
    for tid in turn_ids:
        sid, _, uid = tid.partition(":")
        wanted[sid].add(uid)
    found: dict[str, dict] = {}
    for f in session_files():
        uids = wanted.get(f.stem)
        if not uids:
            continue
        for line_no, line in enumerate(f.open(errors="replace")):
            if not line.strip():
                continue
            try:
                rec = json.loads(line)
            except (json.JSONDecodeError, ValueError):
                continue
            if not isinstance(rec, dict):
                continue
            uid = rec.get("uuid") or str(line_no)
            if uid in uids:
                found[f"{f.stem}:{uid}"] = rec
    return found


def cmd_eval(args) -> int:
    """Score the denoiser against hand labels.

    Predictions are re-derived from source rather than read from the label file.
    A stored prediction measures the classifier as it was when the sample was
    drawn, which means a fixed bug never shows up as fixed.
    """
    path = Path(args.labels)
    if not path.is_file():
        print(f"No label file at {path}. Run `shrink sample` first.", file=sys.stderr)
        return 2
    rows = [json.loads(l) for l in path.open() if l.strip()]
    labeled = [r for r in rows if r.get("label")]
    if not labeled:
        print(f"{len(rows)} rows, none labeled yet.", file=sys.stderr)
        return 2

    records = find_records({r["turn_id"] for r in labeled})
    missing = 0
    for r in labeled:
        rec = records.get(r["turn_id"])
        if rec is None:
            missing += 1
            r["_now"] = r["predicted"]
            r["_reason"] = r["reason"] + " (stale: record aged out)"
        else:
            kind, reason = classify(rec)
            r["_now"], r["_reason"] = kind, reason

    tp = sum(1 for r in labeled if r["_now"] == "authored" and r["label"] == "authored")
    fp = sum(1 for r in labeled if r["_now"] == "authored" and r["label"] != "authored")
    fn = sum(1 for r in labeled if r["_now"] != "authored" and r["label"] == "authored")
    precision = tp / (tp + fp) if tp + fp else 0.0
    recall = tp / (tp + fn) if tp + fn else 0.0

    print(f"labeled {len(labeled)} of {len(rows)}"
          + (f"   ({missing} records no longer on disk)" if missing else ""))
    print(f"  precision  {precision:.3f}   (target >= 0.95)")
    print(f"  recall     {recall:.3f}")
    print(f"  tp {tp}  fp {fp}  fn {fn}")
    if fp or fn:
        print("\nmisclassified:")
        for r in labeled:
            hit = r["_now"] == "authored"
            truth = r["label"] == "authored"
            if hit != truth:
                print(f"  [{r['bucket']}] predicted={r['_now']} label={r['label']}"
                      f"  reason={r['_reason']}\n    {r['excerpt'][:160]!r}")
    drift = [r for r in labeled if r["_now"] != r["predicted"]]
    if drift:
        print(f"\n{len(drift)} rows reclassified since the sample was drawn "
              f"(classifier changed, not the corpus)")
    return 0 if precision >= 0.95 else 1


def cmd_label(args) -> int:
    """Serve a local labeling UI over the eval set.

    Local-only by design: the rows contain verbatim excerpts of the user's own
    prompts, so this binds loopback unless explicitly told otherwise.
    """
    import http.server
    import socketserver
    import threading

    path = Path(args.labels)
    if not path.is_file():
        print(f"No label file at {path}. Run `shrink sample` first.", file=sys.stderr)
        return 2

    page = PLUGIN_ROOT / "web" / "label.html"
    if not page.is_file():
        print(f"Missing UI asset: {page}", file=sys.stderr)
        return 2

    rows = [json.loads(l) for l in path.open() if l.strip()]
    index = {r["turn_id"]: r for r in rows}
    lock = threading.Lock()

    def flush():
        tmp = path.with_suffix(".tmp")
        with tmp.open("w") as fh:
            for r in rows:
                fh.write(json.dumps(r) + "\n")
        tmp.replace(path)

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):  # quiet
            pass

        def _send(self, code, body: bytes, ctype="application/json"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path in ("/", "/index.html"):
                self._send(200, page.read_bytes(), "text/html; charset=utf-8")
            elif self.path == "/api/rows":
                with lock:
                    self._send(200, json.dumps(rows).encode())
            else:
                self._send(404, b'{"error":"not found"}')

        def do_POST(self):
            if self.path != "/api/label":
                self._send(404, b'{"error":"not found"}')
                return
            n = int(self.headers.get("Content-Length") or 0)
            try:
                payload = json.loads(self.rfile.read(n) or b"{}")
            except (json.JSONDecodeError, ValueError):
                self._send(400, b'{"error":"bad json"}')
                return
            row = index.get(payload.get("turn_id"))
            if row is None:
                self._send(404, b'{"error":"unknown turn_id"}')
                return
            with lock:
                row["label"] = payload.get("label")
                flush()
                done = sum(1 for r in rows if r.get("label"))
            self._send(200, json.dumps({"ok": True, "labeled": done}).encode())

    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.ThreadingTCPServer((args.host, args.port), Handler) as srv:
        done = sum(1 for r in rows if r.get("label"))
        print(f"shrink label — {len(rows)} rows, {done} already labeled")
        print(f"  http://{args.host}:{args.port}/")
        print(f"  writing to {path}")
        print("  keys: a t m e u · j/k or arrows to move · ? reveals the prediction")
        print("  ctrl-c to stop")
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            print("\nstopped")
    return 0


REPORT_HOME = Path(os.environ.get("SHRINK_HOME", Path.home() / ".shrink"))


def _bar(v: float, hi: float, width: int = 28) -> str:
    n = 0 if hi <= 0 else int(round(width * v / hi))
    return "█" * n + "·" * (width - n)


def cmd_dry(args) -> int:
    """The sincere tier. No model calls, no network."""
    corpus = Corpus.load(days=args.days)
    if not corpus.turns:
        print("Nothing to report on. Either no sessions, or none in the window.",
              file=sys.stderr)
        return 2
    if len(corpus.turns) < 50:
        print(f"Only {len(corpus.turns)} authored turns in the window. "
              f"That is not enough to say anything about you — come back later.",
              file=sys.stderr)
        return 2

    typed = [t.typed for t in corpus.turns if t.typed.strip()]
    trimmed = sum(t.pasted_chars for t in corpus.turns)
    total = sum(len(t.text) for t in corpus.turns)
    m = measure(typed)

    W = 64
    print("=" * W)
    print("  shrink — dry tier".ljust(W - 12) + "no model calls")
    print("=" * W)
    print()
    print(f"  {len(corpus.turns):,} authored turns over {args.days} days, "
          f"{len(corpus.files)} sessions")
    if trimmed:
        print(f"  {trimmed:,} of {total:,} characters trimmed as pasted "
              f"({100*trimmed/total:.0f}%) — measuring the {m['words']:,} words "
              f"you actually typed")
    print()

    # ---- circadian -------------------------------------------------------
    print("  WHEN YOU WORK")
    print()
    hours = Counter()
    for t in corpus.turns:
        h = local_hour(t.ts)
        if h:
            hours[h.hour] += 1
    hi = max(hours.values()) if hours else 1
    for h in range(24):
        n = hours.get(h, 0)
        mark = "  " if 6 <= h < 22 else " ·"
        print(f"    {h:02d}:00 {_bar(n, hi)} {n:>4}{mark}")
    night = sum(n for h, n in hours.items() if h < 6 or h >= 22)
    print()
    print(f"    {100*night/max(1,sum(hours.values())):.0f}% of what you say, "
          f"you say after 22:00 or before 06:00")
    print()

    dow = Counter()
    for t in corpus.turns:
        h = local_hour(t.ts)
        if h:
            dow[h.strftime("%a")] += 1
    hi = max(dow.values()) if dow else 1
    for d in ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"):
        print(f"    {d} {_bar(dow.get(d, 0), hi)} {dow.get(d, 0):>4}")
    weekend = dow.get("Sat", 0) + dow.get("Sun", 0)
    print()
    print(f"    {100*weekend/max(1,sum(dow.values())):.0f}% of it on a weekend")
    print()

    # ---- register --------------------------------------------------------
    print("  HOW YOU TALK")
    print()
    rows = [
        ("median message", f"{m['median_chars']} chars",
         f"mean {m['mean_chars']}, p95 {m['p95_chars']}"),
        ("questions", f"{100*m['question_ratio']:.0f}%", "of messages"),
        ("imperatives", f"{100*m['imperative_ratio']:.0f}%", "of messages"),
        ("hedging", f"{m['hedging_per_1k']}", "per 1k words"),
        ("politeness", f"{m['politeness_per_1k']}", "per 1k words"),
        ("profanity", f"{m['profanity_per_1k']}", "per 1k words"),
        ("repair phrases", f"{m['repair_per_1k']}", "per 1k words"),
        ("emphatic caps", f"{m['caps_per_1k']}", "per 1k words"),
        ("we : I", f"{m['we_vs_i']}", "plural to singular"),
        ("second person", f"{m['you_per_1k']}", "per 1k words"),
    ]
    for label, val, note in rows:
        print(f"    {label:<18} {val:>12}   {note}")
    print()

    interrupts = [e for e in corpus.events if e["kind"] == "interrupt"]
    print(f"    you interrupted {len(interrupts)} times "
          f"({len(interrupts)/max(1,len(corpus.files)):.2f} per session)")
    print()

    # ---- per project -----------------------------------------------------
    byproj = defaultdict(list)
    for t in corpus.turns:
        if t.typed.strip():
            byproj[t.project].append(t.typed)
    big = [kv for kv in sorted(byproj.items(), key=lambda kv: -len(kv[1]))[:6]
           if len(kv[1]) >= 20]
    if len(big) < 2:
        print("  WHO YOU ARE, BY PROJECT")
        print()
        print(f"    Only one project has enough turns to compare "
              f"({len(byproj)} seen). Cross-project register needs at least two.")
        print()
    else:
        print("  WHO YOU ARE, BY PROJECT")
        print()
        print(f"    {'project':<26}{'turns':>7}{'median':>8}{'hedge':>7}"
              f"{'polite':>8}{'imper':>7}")
        for proj, texts in big:
            pm = measure(texts)
            name = proj.rsplit("/", 1)[-1][:24] or proj[:24]
            print(f"    {name:<26}{pm['turns']:>7}{pm['median_chars']:>8}"
                  f"{pm['hedging_per_1k']:>7}{pm['politeness_per_1k']:>8}"
                  f"{100*pm['imperative_ratio']:>6.0f}%")
        print()

    # ---- long baseline ---------------------------------------------------
    if corpus.history:
        import datetime
        months = defaultdict(list)
        for h in corpus.history:
            ts = h.get("ts")
            if not ts:
                continue
            d = datetime.datetime.fromtimestamp(ts / 1000 if ts > 1e11 else ts)
            months[d.strftime("%Y-%m")].append(h["text"])
        # Thin months make the slope noise, not signal.
        keys = sorted(k for k, v in months.items() if len(v) >= 100)
        if len(keys) >= 3:
            print("  OVER TIME  (history.jsonl — longer than the 30-day window)")
            print()
            print(f"    {'month':<10}{'prompts':>9}{'median':>8}{'hedge':>8}"
                  f"{'polite':>8}{'profan':>8}")
            series = {}
            for i, k in enumerate(keys):
                pm = measure(months[k])
                print(f"    {k:<10}{pm['turns']:>9}{pm['median_chars']:>8}"
                      f"{pm['hedging_per_1k']:>8}{pm['politeness_per_1k']:>8}"
                      f"{pm['profanity_per_1k']:>8}")
                for field in ("median_chars", "hedging_per_1k",
                              "politeness_per_1k", "profanity_per_1k"):
                    series.setdefault(field, []).append((i, pm[field]))
            print()
            for field, pts in series.items():
                sl = slope(pts)
                if sl is None:
                    continue
                ys = [y for _, y in pts]
                base = statistics.mean(ys)
                # Percent-of-first is meaningless when the first month is near
                # zero -- it produced a "214% decline" on profanity. Normalize
                # against the series mean and always show the endpoints, so the
                # reader can check the claim against the numbers above.
                pct = 0.0 if base == 0 else 100 * sl * (len(pts) - 1) / base
                a, b = ys[0], ys[-1]
                fmt = (lambda v: f"{v:.2f}") if base < 10 else (lambda v: f"{v:.0f}")
                net = 0.0 if base == 0 else 100 * (b - a) / base
                # A trend line and the endpoints can disagree when the series
                # peaks in the middle. Saying "up 11%" about 2.04 -> 2.03 is
                # true of the fit and false of the person.
                if (sl > 0) != (net > 0) and abs(net) < 10:
                    print(f"    {field:<20} ~  no net change, peaked mid-series"
                          f"   ({fmt(a)} → {fmt(b)})")
                    continue
                if abs(pct) < 5:
                    print(f"    {field:<20} —  flat   ({fmt(a)} → {fmt(b)})")
                    continue
                arrow = "↑" if sl > 0 else "↓"
                print(f"    {field:<20} {arrow} {abs(pct):3.0f}%   "
                      f"({fmt(a)} → {fmt(b)}) over {len(pts)} months")
            print()

    # ---- metrics series --------------------------------------------------
    if not args.no_series:
        REPORT_HOME.mkdir(parents=True, exist_ok=True)
        series_file = REPORT_HOME / "metrics.jsonl"
        row = {"summary_version": SUMMARY_VERSION, "days": args.days,
               "sessions": len(corpus.files), "trimmed_chars": trimmed,
               "interrupts": len(interrupts), **m}
        with series_file.open("a") as fh:
            fh.write(json.dumps(row) + "\n")
        prior = [json.loads(l) for l in series_file.open() if l.strip()]
        print(f"  metrics appended to {series_file} ({len(prior)} runs)")
        if len(prior) > 1:
            print()
            print("  SINCE YOUR FIRST RUN")
            base = prior[0]
            for field in ("median_chars", "hedging_per_1k", "politeness_per_1k",
                          "profanity_per_1k", "imperative_ratio"):
                a, b = base.get(field), row.get(field)
                if not a:
                    continue
                d = 100 * (b - a) / a
                if abs(d) >= 1:
                    print(f"    {field:<20} {'+' if d > 0 else ''}{d:.0f}%")
    print()
    return 0


def cmd_stub(name: str):
    def run(args) -> int:
        print(f"`shrink {name}` is not implemented yet.", file=sys.stderr)
        return 3
    return run


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="shrink", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("digest", help="extract + denoise + dry-tier stats")
    d.add_argument("--days", type=int, default=None,
                   help="window in days (default: all available)")
    d.add_argument("--json", metavar="PATH", help="also write the normalized corpus")
    d.set_defaults(func=cmd_digest)

    s = sub.add_parser("sample", help="emit a stratified labeling set")
    s.add_argument("-n", type=int, default=200)
    s.add_argument("--out", default="eval/labels.jsonl")
    s.add_argument("--exclude", nargs="*", default=[],
                   help="label files whose rows to skip (draw a clean holdout)")
    s.set_defaults(func=cmd_sample)

    e = sub.add_parser("eval", help="score the denoiser against hand labels")
    e.add_argument("--labels", default="eval/labels.jsonl")
    e.set_defaults(func=cmd_eval)

    dry = sub.add_parser("dry", help="the sincere tier — stats only, no model calls")
    dry.add_argument("--days", type=int, default=30)
    dry.add_argument("--no-series", action="store_true",
                     help="do not append to the metrics series")
    dry.set_defaults(func=cmd_dry)

    lb = sub.add_parser("label", help="serve a local labeling UI over the eval set")
    lb.add_argument("--labels", default="eval/labels.jsonl")
    lb.add_argument("--port", type=int, default=7331)
    lb.add_argument("--host", default="127.0.0.1",
                    help="loopback by default; the rows contain your own prompts")
    lb.set_defaults(func=cmd_label)

    for name, helptext in (("excerpt", "fetch context around a turn id [M3]"),
                           ("verify", "check a quote against source [M3]"),
                           ("render", "build the report [M5]"),
                           ("purge", "wipe reports and cache")):
        sp = sub.add_parser(name, help=helptext)
        sp.set_defaults(func=cmd_stub(name))

    args = p.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
